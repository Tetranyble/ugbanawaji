APP_NAME="Ugbanawaji"
APP_ENV=local
APP_URL=http://localhost:3000
APP_LOCALE=en
APP_TIMEZONE=Africa/Lagos
APP_KEY=
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ugbanawaji
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
DB_POOL_LIMIT=10

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_NAME="Leonard Ekenekiso"
ADMIN_EMAIL=u.ekenekiso@ugbanawaji.com
ADMIN_PASSWORD=

FILESYSTEM_DISK=local
UPLOAD_MAX_MB=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=false
# Optional public S3 or CDN origin, for example https://media.example.com.
# Leave empty to serve private S3 objects through the app's absolute /api/media URL.
AWS_PUBLIC_URL=

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/admin/storage/google/callback
GOOGLE_DRIVE_FOLDER_NAME="Ugbanawaji Portfolio Media"

# Transactional application mail (confirmation/contact notifications).
MAIL_MAILER=log
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=u.ekenekiso@ugbanawaji.com
MAIL_FROM_NAME="Ekenekiso Ugbanawaji"
MAIL_TO_ADDRESS=u.ekenekiso@ugbanawaji.com

# Newsletter campaigns deliberately use a separate newsletter-capable transport.
NEWSLETTER_MAILER=log
NEWSLETTER_MAIL_HOST=127.0.0.1
NEWSLETTER_MAIL_PORT=587
NEWSLETTER_MAIL_SCHEME=tls
NEWSLETTER_MAIL_USERNAME=
NEWSLETTER_MAIL_PASSWORD=
NEWSLETTER_MAIL_FROM_ADDRESS=u.ekenekiso@ugbanawaji.com
NEWSLETTER_MAIL_FROM_NAME="Ekenekiso Ugbanawaji"
NEWSLETTER_BATCH_SIZE=25
NEWSLETTER_CRON_SECRET=
SCHEDULER_CRON_SECRET=

# Evidence-grounded Ask Ugbanawaji. Chat generation and embeddings can use
# different providers. Supported values: openai, ollama, openai_compatible, kimi, disabled.
# AI_PROVIDER remains as a backward-compatible fallback when the two provider
# variables below are omitted.
AI_CHAT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama (local/self-hosted). When Next.js itself runs in Docker on macOS/Windows,
# use http://host.docker.internal:11434 instead of 127.0.0.1.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Any OpenAI-compatible chat/embedding server, including self-hosted Kimi served
# through vLLM/SGLang. Kimi is normally used for chat while Ollama/OpenAI supplies
# embeddings, because Kimi itself is not an embedding model.
AI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
AI_COMPATIBLE_API_KEY=EMPTY
AI_COMPATIBLE_CHAT_MODEL=moonshotai/Kimi-K2.6
AI_COMPATIBLE_EMBEDDING_MODEL=

# Convenience alias for self-hosted Kimi chat. Set AI_CHAT_PROVIDER=kimi.
KIMI_BASE_URL=http://127.0.0.1:8000/v1
KIMI_API_KEY=EMPTY
KIMI_CHAT_MODEL=moonshotai/Kimi-K2.6

AI_REQUEST_TIMEOUT_MS=180000
AI_MAX_QUESTIONS_PER_HOUR=20
AI_MAX_CONVERSATION_MESSAGES=10
AI_MAX_CONTEXT_CHUNKS=8
AI_MIN_RETRIEVAL_SCORE=0.18
AI_INDEX_BATCH_SIZE=2
AI_INDEX_MAX_ATTEMPTS=5
AI_INDEX_RETRY_DELAY_SECONDS=60
AI_INDEX_STALE_LOCK_MINUTES=20

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/ugbanawaji
PROFILE_EMAIL=u.ekenekiso@ugbanawaji.com
PROFILE_LOCATION="Lagos, Nigeria"
