{
  "name": "ugbanawaji-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/check-build-dependencies.mjs",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node server.js",
    "package:namecheap": "bash scripts/package-namecheap.sh",
    "deploy:namecheap": "NEXT_OUTPUT=standalone APP_URL=https://ugbanawaji.com NEXT_PUBLIC_SITE_URL=https://ugbanawaji.com BETTER_AUTH_URL=https://ugbanawaji.com npm run build && npm run package:namecheap",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "content:cleanup": "tsx scripts/editorial-cleanup.ts",
    "setup:local": "bash scripts/setup-local.sh",
    "check": "npm run typecheck && npm run lint && npm run build",
    "release:check": "npm run lockfile:check && npm run auth:migration:check && tsx scripts/release-check.ts",
    "newsletter:run": "tsx scripts/newsletter-worker.ts",
    "db:truncate": "tsx scripts/db-truncate.ts",
    "db:reset": "npm run db:truncate -- --yes && npm run db:seed",
    "ai:check": "tsx scripts/ai-check.ts",
    "ai:index:work": "tsx scripts/ai-index-worker.ts",
    "ai:index:queue-all": "tsx scripts/ai-index-queue-all.ts",
    "scheduler:run": "tsx scripts/scheduler.ts",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "auth:migration:check": "node scripts/check-auth-migration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-toast": "1.2.23",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-youtube": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.37.0",
    "marked": "18.0.11",
    "mysql2": "3.24.2",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "nodemailer": "9.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sanitize-html": "2.17.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "tsx": "4.23.12",
    "zod": "4.5.4",
    "better-auth": "1.7.2",
    "@better-auth/drizzle-adapter": "1.7.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "drizzle-kit": "0.31.10"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@4.23.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
